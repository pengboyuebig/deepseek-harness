# Copy to production.env and configure the production service before selecting this preset.
GLH_DESKTOP_APP_ID=com.deepseek.dsh
GLH_DESKTOP_AUTO_UPDATE_ENV=production
GLH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
GLH_DESKTOP_MACOS_PACK_CONCURRENCY=4
GLH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
GLH_DESKTOP_MACOS_DOWNLOAD_PROXY=
GLH_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# GLH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
