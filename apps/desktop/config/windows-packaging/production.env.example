# Copy to production.env in the same machine configuration directory and fill in the values.
GLH_DESKTOP_APP_ID=com.deepseek.dsh
GLH_DESKTOP_AUTO_UPDATE_ENV=production
GLH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
GLH_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# GLH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
GLH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
GLH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
